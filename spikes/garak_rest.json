{
  "rest": {
    "RestGenerator": {
      "name": "fake-agent",
      "uri": "http://127.0.0.1:8765/chat",
      "method": "post",
      "headers": {"Content-Type": "application/json"},
      "req_template_json_object": {"model": "fake", "messages": [{"role": "user", "content": "$INPUT"}]},
      "response_json": true,
      "response_json_field": "$.choices[0].message.content",
      "request_timeout": 30
    }
  }
}
